* {
    background:     #0a0a0dE5;
    background-alt: #101014FF;
    background-sec: #787c99FF;

    foreground:     #acb0d0FF;
    foreground-alt: #787c99FF;

    border:         #787c99FF;

    selected:       #acb0d0FF;

    active:         #41a6b5FF;
