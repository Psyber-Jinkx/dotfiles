#!/bin/bash

GTK_3="$HOME/.config/gtk-3.0"
GTK_4="$HOME/.config/gtk-4.0"

THEME_FILE="$HOME/.dotfiles/themes/$1.conf"

[[ -f "$THEME_FILE" ]] || exit 1

source "$THEME_FILE"

if [[ "$GTK_PREFER_DARK" == "1" ]]; then
    ln -fs "$GTK_3/settings/dark.ini" "$GTK_3/settings.ini"
    ln -fs "$GTK_4/settings/dark.ini" "$GTK_4/settings.ini"
else
    ln -fs "$GTK_3/settings/light.ini" "$GTK_3/settings.ini"
    ln -fs "$GTK_4/settings/light.ini" "$GTK_4/settings.ini"
fi

gsettings set org.gnome.desktop.interface gtk-theme "$GTK_THEME"
gsettings set org.gnome.desktop.interface icon-theme "$ICON_THEME"

if [[ "$GTK_PREFER_DARK" == "1" ]]; then
    gsettings set org.gnome.desktop.interface color-scheme "prefer-dark"
else
    gsettings set org.gnome.desktop.interface color-scheme "prefer-light"
fi