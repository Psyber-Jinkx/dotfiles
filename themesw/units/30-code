#!/bin/bash

cd "$HOME/.config/VSCodium/User/" || exit 1

THEME_FILE="$HOME/.dotfiles/themes/$1.conf"

[[ -f "$THEME_FILE" ]] || exit 1

source "$THEME_FILE"

TMP=$(mktemp)

jq --arg theme "$VSCODE_THEME" \
    '.["workbench.colorTheme"] = $theme' \
    "settings.json" > "$TMP" && mv "$TMP" "settings.json"