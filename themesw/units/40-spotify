#!/bin/bash

GENERATED_DIR="$HOME/.dotfiles/generated/spotify"
SPOTIFY_DIR="$HOME/.config/spicetify/Themes/Custom"

ln -fs "$GENERATED_DIR/$1.css" "$SPOTIFY_DIR/user.css"

spicetify refresh

if pgrep -x spotify >/dev/null; then
    pkill -x spotify
    hyprctl dispatch 'hl.dsp.exec_raw("spotify-launcher")'
fi