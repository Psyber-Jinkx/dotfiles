{
    "layer": "top",
    "position": "top",
    "height": 29,
    "margin": "5 0",

   "group/right-hidden": {
    "orientation": "horizontal",
    "drawer": {
        "transition-duration": 500,
        "transition-left-to-right": true,
        "click-to-reveal": true
    },
    "modules": [
        "custom/arrow-left",
        "memory"
    ]
    },

    "group/right-hidden-top": {
        "orientation": "horizontal",
        "modules": [
            "group/right-hidden",
            "custom/ctlcenter"
        ]
    },

    "modules-left": [
        "hyprland/workspaces",
        "mpris"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "group/group-volume",
        "network",
        "tray",
        "group/right-hidden-top"
    ],

    "include": [
        "~/.config/waybar/modules.jsonc"
    ]
}